[Unit]
Description=XAUUSD Datadog Bits agent (demo-only harness)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xauusd
EnvironmentFile=/root/xauusd/.env
ExecStart=/root/xauusd/.venv/bin/python -m xauusd.cli agent run
Restart=on-failure
RestartSec=30
# The operator authorizes arbitrary shell execution in this container.
# Commands share the service filesystem/network privileges; this is not isolation.
KillMode=control-group
TimeoutStopSec=30
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
