[Unit]
Description=XAUUSD autonomous agent (paper-only, live thinking view)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/xauusd
EnvironmentFile=/root/xauusd/.env
ExecStart=/root/xauusd/.venv/bin/python -m xauusd.cli agent run
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
# Local SQLite state (STATE_DB_PATH), in-loop market-data refresh, and heartbeat writes.
ReadWritePaths=/root/xauusd/reports /root/xauusd/state /root/xauusd/data /root/xauusd/backups

[Install]
WantedBy=multi-user.target