CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
# OAuth2 token pair minted via https://id.ctrader.com grantingaccess -> /apps/token.
# CTRADER_ACCESS_TOKEN is also used by the execution adapter and the data downloader.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_DEMO_ONLY=false
# Execution and data updates are disabled unless this is exactly true; the Open API
# execution transport and the data downloader only permit demo.ctraderapi.com.
# Leave CTRADER_CTID_TRADER_ACCOUNT_ID empty to auto-discover the XAUUSD demo account
# from the OAuth token; set it to pin a specific demo account (legacy leaf-token mode).
CTRADER_CTID_TRADER_ACCOUNT_ID=
CTRADER_OPEN_API_HOST=demo.ctraderapi.com
CTRADER_OPEN_API_PORT=5035
CTRADER_OPEN_API_TIMEOUT_SECONDS=30
# The symbol stays XAUUSD for the demo execution adapter.
CTRADER_SYMBOL=XAUUSD
# `demo-automation` is inert unless this is exactly true. Use `status` before `once` or `run`.
CTRADER_AUTOMATION_ENABLED=false
# Broker-free paper-only stage: runs the deterministic paper pipeline without cTrader credentials
# or volumes. Requires only CTRADER_AUTOMATION_ENABLED=true (paper/transcript state is local by default).
CTRADER_PAPER_ONLY=false
CTRADER_AUTOMATION_POLL_SECONDS=30
CTRADER_AUTOMATION_MAX_CONSECUTIVE_FAILURES=3
CTRADER_AUTOMATION_MAX_MARKET_DATA_AGE_SECONDS=180
CTRADER_AUTOMATION_STATUS_PATH=reports/demo_runner_status.json
# Required for enabled `demo-automation once` or `demo-automation run`; must be a positive integer.
# Resulting volume must respect the XAUUSD broker min/max/step; the broker metadata is enforced at runtime.
CTRADER_VOLUME_PER_PAPER_UNIT=
CTRADER_CANARY_PAPER_QUANTITY=1
# Read-only market-data tuning and fail-loud status.
CTRADER_DATA_UPDATE_PAGE_SIZE=5000
CTRADER_DATA_UPDATE_OVERLAP_MINUTES=10
CTRADER_DATA_UPDATE_STATUS_PATH=reports/data_update_status.json
PAPER_INITIAL_CASH=100000
PAPER_DAILY_LOSS_LIMIT=500
PAPER_MAX_DRAWDOWN=0.10
PAPER_MAX_POSITION=1
PAPER_MAX_TRADES_PER_DAY=20
PAPER_MAX_MARKET_DATA_AGE_SECONDS=180
# State backend for the agent paper account and transcript. `local` (default) needs no
# network and keeps paper + transcript in STATE_DB_PATH (SQLite). `cockroach` restores
# the DATABASE_URL-backed cloud stores.
XAUUSD_STATE_BACKEND=local
STATE_DB_PATH=state/xauusd_local.db
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
PORT=8080
DATABASE_URL=
# CockroachDB Cloud connection. Keep credentials only in .env.
DATABASE_URL_DIRECT=
DATABASE_TRANSACTION_ISOLATION=read_committed
COCKROACH_USER=
COCKROACH_PASSWORD=
COCKROACH_CLUSTER_ID=
COCKROACH_HOST=
COCKROACH_PORT=26257
COCKROACH_DATABASE=defaultdb
COCKROACH_SSLROOTCERT=/root/.postgresql/root.crt
COMPUTE_HOST=
COMPUTE_PORT=22
COMPUTE_USER=root
COMPUTE_SSH_KEY=/root/.ssh/xauusd_compute
COMPUTE_ROOT=/opt/xauusd
COMPUTE_RESULT_ROOT=/opt/xauusd/var/results
COMPUTE_WORKERS=16
COMPUTE_MAX_RETRIES=3
COMPUTE_CIRCUIT_FAILURE_THRESHOLD=8
COMPUTE_CIRCUIT_COOLDOWN_SECONDS=60
COMPUTE_DISK_WARNING_PERCENT=80
COMPUTE_DISK_CRITICAL_PERCENT=90
COMPUTE_CLOCK_WARNING_SECONDS=1
COMPUTE_DRAIN_PATH=reports/tournament/distributed/DRAIN
COMPUTE_ARTIFACT_AUDIT_PERCENT=1
OPENAI_BASE_URL=https://api.openai.com/v1
# A single continuously-trading AI agent reads OPENAI_* and streams its thinking to a live view.
OPENAI_MODEL=
OPENAI_API_KEY=
# Agent loop controls. `agent run` is inert unless CTRADER_AUTOMATION_ENABLED is exactly true.
AGENT_GOAL=
AGENT_POLL_SECONDS=60
AGENT_MAX_STEPS_PER_TICK=4
AGENT_SYMBOL=XAUUSD
# Freshness gates measure from when the newest M1 bar CLOSED, not from its open
# timestamp, so the achievable minimum is ~0s and a bar interval is one minute.
# Keep this at 2-3 bar intervals or more: below ~120 the gate can never pass and
# every tick dies as stale_data without ever reaching the planner. The same
# semantic governs PAPER_MAX_MARKET_DATA_AGE_SECONDS and
# CTRADER_AUTOMATION_MAX_MARKET_DATA_AGE_SECONDS; keep all three consistent.
AGENT_MAX_MARKET_DATA_AGE_SECONDS=180
# Optional in-loop market-data refresh. Opt-in; when enabled, a stale tick refreshes the
# local M1 parquet before reasoning. Auth failures stay loud and never bypass the paper gates.
# MAX_AGE_SECONDS below the freshness gate (AGENT_MAX_MARKET_DATA_AGE_SECONDS) keeps the
# agent trade-ready at tick time; MIN_INTERVAL_SECONDS bounds the polling to one refresh per minute.
AGENT_DATA_REFRESH_ENABLED=false
AGENT_DATA_REFRESH_MAX_AGE_SECONDS=30
AGENT_DATA_REFRESH_MIN_INTERVAL_SECONDS=60
AGENT_DATA_REFRESH_TIMEOUT_SECONDS=120
# Live heartbeat surfaced by the agent view and /api/health (state fail-loud observability).
AGENT_STATUS_FILE=reports/agent_status.json
AGENT_VIEW_HOST=127.0.0.1
AGENT_VIEW_PORT=8100
FIRECRAWL_API_KEY=
# Comma-separated HTTPS source domains, such as reuters.com,fred.stlouisfed.org
# A single * allows any HTTPS source domain (credentials are still rejected by the harness).
FIRECRAWL_ALLOWED_DOMAINS=
FIRECRAWL_TIMEOUT_SECONDS=30
FIRECRAWL_MAX_CONTENT_CHARS=30000
