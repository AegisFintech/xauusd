# Copy to .env (mode 0600). .env.sample is an alias of this file.
# Datadog region: us1, us3, us5, eu, ap1, ap2, uk1.
AGENT_PLANNER=datadog
DD_REGION=us1
DD_API_KEY=
DD_APP_KEY=
DD_AGENT_ID=
DD_BITS_WORKFLOW_ID=
DD_HTTP_TIMEOUT_SECONDS=20
DD_WORKFLOW_TIMEOUT_SECONDS=300
# Published workflow: STRING input -> Run Agent prompt; STRING output -> final reply.

# cTrader OAuth2 demo credentials, used by the existing data downloader.
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_DEMO_ONLY=false
CTRADER_OPEN_API_HOST=demo.ctraderapi.com
# Empty account ID discovers the verified demo account and XAUUSD symbol.
CTRADER_CTID_TRADER_ACCOUNT_ID=
CTRADER_AUTOMATION_ENABLED=false
CTRADER_PAPER_ONLY=true
# Required only for broker demo execution, not paper trading:
CTRADER_VOLUME_PER_PAPER_UNIT=

XAUUSD_STATE_BACKEND=local
STATE_DB_PATH=state/xauusd_local.db
# Required only for the Cockroach backend or database-backed research features.
DATABASE_URL=
DATABASE_URL_DIRECT=

PAPER_INITIAL_CASH=100000
PAPER_DAILY_LOSS_LIMIT=500
PAPER_MAX_DRAWDOWN=0.10
PAPER_MAX_POSITION=1
PAPER_MAX_TRADES_PER_DAY=20
PAPER_MAX_MARKET_DATA_AGE_SECONDS=180

# Polling advances jobs/workflows; completed cycles wait at least 60 seconds.
AGENT_POLL_SECONDS=10
AGENT_MAX_STEPS_PER_TICK=4
AGENT_MAX_MARKET_DATA_AGE_SECONDS=180
AGENT_DATA_REFRESH_ENABLED=true
AGENT_DATA_REFRESH_MAX_AGE_SECONDS=30
AGENT_DATA_REFRESH_MIN_INTERVAL_SECONDS=60
AGENT_DATA_REFRESH_TIMEOUT_SECONDS=120
AGENT_STATUS_FILE=reports/agent_status.json
AGENT_VIEW_HOST=127.0.0.1
AGENT_VIEW_PORT=8100

# Optional existing research/remote-compute features; not required by Bits.
FIRECRAWL_API_KEY=
FIRECRAWL_ALLOWED_DOMAINS=
COMPUTE_HOST=
COMPUTE_PORT=22
COMPUTE_USER=root
COMPUTE_SSH_KEY=
COMPUTE_ROOT=/opt/xauusd
COMPUTE_WORKERS=16
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
PORT=8080
